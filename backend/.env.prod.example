# MongoDB - PROD cluster
MONGO_URI=mongodb+srv://<user>:<password>@healthflex-prod.su93nwo.mongodb.net/stance-dashboard?retryWrites=true&w=majority
MONGO_DB=stance-dashboard


# LLM provider — provider-agnostic switch (see backend/utils/llm_provider.py).
# All 5 agents (recommendation, prognosis, query, triage, clinical) now go
# through this. Changing provider (e.g. to bedrock later) is meant to be this
# value plus one new branch in llm_provider.py — no agent code changes.
# Google Cloud / Vertex AI vars removed here — no longer read by any agent.
LLM_PROVIDER=anthropic
LLM_API_KEY=

# Per-agent model overrides (optional — each agent defaults to claude-haiku-5-5 if unset)
RECOMMENDATION_MODEL=claude-haiku-5-5
PROGNOSIS_MODEL=claude-haiku-5-5
QUERY_MODEL=claude-haiku-5-5
TRIAGE_MODEL=claude-haiku-5-5
CLINICAL_MODEL=claude-haiku-5-5


# Auto-start change stream listener
AUTO_START_CHANGE_STREAM=true

